# Local placeholder. The server rejects this value unless VFDIAG_LOCAL_ONLY=1.
# That flag is not a firewall. Compose publishes 127.0.0.1:8787 only.
# Replace this token before any non-loopback publish. Do not reuse a VRAE key.
VFDIAG_SERVICE_TOKEN=local-docker-dev-token-change-me
VFDIAG_LOCAL_ONLY=1

# Tailscale Funnel for a Vercel Preview call:
#   npm run issue-token
#   docker compose -f docker-compose.yml -f docker-compose.synthetic.yml -f docker-compose.funnel.yml up --build -d
#   tailscale funnel --bg --https=10000 http://127.0.0.1:8787
# Port 10000 is used because 443 and 8443 may already belong to other local services.
# Copy VFDIAG_SERVICE_TOKEN from the gitignored .env into the Vercel Preview environment.
# Do not print that value. The placeholder above is refused when VFDIAG_FUNNEL=1.
